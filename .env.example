# Rationale for every knob: docs/configuration.md

POSTGRES_USER=trading
POSTGRES_PASSWORD=<secret>
POSTGRES_DB=trading_desk
DATABASE_URL=postgresql+psycopg://trading:<secret>@postgres:5432/trading_desk
DATABASE_MIGRATION_URL=postgresql+psycopg://trading:<secret>@localhost:5432/trading_desk

MARKET_DATA_STREAM_URL=http://market-data-service:8001/market-data/stream
VALUATION_STREAM_URL=http://pricing-service:8002/valuation-stream
BLOTTER_SERVICE_URL=http://blotter-service:8006

MARKET_DATA_SERVICE_HEALTHCHECK_URL=http://market-data-service:8001/health
PRICING_SERVICE_HEALTHCHECK_URL=http://pricing-service:8002/health
MONITORING_SERVICE_HEALTHCHECK_URL=http://monitoring-service:8003/health
BOOKS_SERVICE_HEALTHCHECK_URL=http://books-service:8004/health
TRADE_ACTION_SERVICE_HEALTHCHECK_URL=http://trade-action-service:8008/health
BLOTTER_SERVICE_HEALTHCHECK_URL=http://blotter-service:8006/health

LOG_LEVEL=INFO
LOG_DIR=/var/log/trading
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUP_COUNT=3

FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

FINNHUB_TIER1_POLL_SECONDS=15
FINNHUB_TIER2_POLL_SECONDS=60
FINNHUB_CLOSED_POLL_SECONDS=300
PROVIDER_BUDGET_USAGE_PERCENT=90
PROVIDER_ACTIVE_WINDOW_HOURS=12
FINNHUB_PROVIDER_LIMIT_PER_MINUTE=60
TWELVE_DATA_POLL_SECONDS=900
TWELVE_DATA_PROVIDER_LIMIT_PER_DAY=800
TWELVE_DATA_PROVIDER_LIMIT_PER_MINUTE=8
SNAPSHOT_RETENTION_DAYS=90
MAX_ACTIVE_SYMBOLS=25
NBP_FIXING_SYMBOLS=EURPLN,USDPLN,XAUPLN_G
ECB_FIXING_SYMBOLS=EURUSD,EURPLN
FRED_PROVIDER_LIMIT_PER_MINUTE=120
EIOPA_REQUEST_BUDGET_PER_MINUTE=10

TRADE_PRICE_TOLERANCE_PCT=1.0
TRADE_ACTION_QUEUE_SIZE=1000
TRADE_ACTION_BATCH_SIZE=100
DEFAULT_QUOTE_PROVIDER=FINNHUB

BENCHMARK_SYMBOL=SPY
BENCHMARK_PROVIDER=FINNHUB

BOOK_RISK_WINDOW=100
BOOK_RISK_MINIMUM_OBSERVATIONS=20
BOOK_CAPITAL_BASE=1000000
PORTFOLIO_CAPITAL_BASE=
