POSTGRES_USER=trading
POSTGRES_PASSWORD=<secret>
POSTGRES_DB=trading_desk
DATABASE_URL=postgresql+psycopg://trading:<secret>@postgres:5432/trading_desk
DATABASE_MIGRATION_URL=postgresql+psycopg://trading:<secret>@localhost:5432/trading_desk

FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

LOG_LEVEL=INFO
LOG_DIR=/var/log/trading

# Service addresses default to Compose hostnames. For local processes, override
# MARKET_DATA_SERVICE_URL, PRICING_SERVICE_URL, MONITORING_SERVICE_URL,
# BOOKS_SERVICE_URL, BLOTTER_SERVICE_URL and TRADE_ACTION_SERVICE_URL.
# Optional polling, budget and retention settings live in desk-runtime's config.py
# and in each service's config.py.
