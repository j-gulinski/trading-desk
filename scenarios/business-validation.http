###############################################################################
# Scenario: worker business validation (book must exist + asset class must match)
# Intake returns 202, but the worker rejects intents whose book is missing or
# whose asset_class doesn't match the book's expected_asset_class - no trade is
# written, so the minted trade_id has no valuation (404). Queried by id (no noise).
###############################################################################

@books   = http://localhost:8004
@actions = http://localhost:8008
@pricing = http://localhost:8002

### An EQUITY book
# @name createBook
POST {{books}}/books
Content-Type: application/json

{ "name": "EQUITY_ONLY_{{$timestamp}}", "expected_asset_class": "EQUITY" }

###
@bookId = {{createBook.response.body.$.book_id}}

### REJECT 1: a FUTURES trade into an EQUITY book -> 202, worker rejects (asset_class mismatch)
# @name mismatch
POST {{actions}}/trade-actions
Content-Type: application/json

{ "action_type": "OPEN_TRADE", "client_request_id": "mis-{{$timestamp}}", "book_id": "{{bookId}}", "asset_class": "FUTURES", "symbol": "ES_FUT", "side": "BUY", "quantity": 1, "trade_price": 5000 }

###
@mismatchId = {{mismatch.response.body.$.trade_id}}

### REJECT 2: a trade into a non-existent book -> 202, worker rejects (book not found)
# @name nobook
POST {{actions}}/trade-actions
Content-Type: application/json

{ "action_type": "OPEN_TRADE", "client_request_id": "nob-{{$timestamp}}", "book_id": "00000000-0000-0000-0000-000000000000", "asset_class": "EQUITY", "symbol": "ACME", "side": "BUY", "quantity": 1, "trade_price": 100 }

###
@nobookId = {{nobook.response.body.$.trade_id}}

### --- wait ~3s ---

### The mismatch trade was NOT created -> 404
GET {{pricing}}/valuations/{{mismatchId}}

### The no-book trade was NOT created -> 404
GET {{pricing}}/valuations/{{nobookId}}

### Counters: `rejected` ticked up by 2 (cumulative across the service lifetime)
GET {{actions}}/queue/status

### Sanity: a MATCHING trade (EQUITY into the EQUITY book) IS accepted + created
# @name ok
POST {{actions}}/trade-actions
Content-Type: application/json

{ "action_type": "OPEN_TRADE", "client_request_id": "ok-{{$timestamp}}", "book_id": "{{bookId}}", "asset_class": "EQUITY", "symbol": "ACME", "side": "BUY", "quantity": 10, "trade_price": 100 }

###
@okId = {{ok.response.body.$.trade_id}}

### --- wait ~3s --- this one IS priced (200)
GET {{pricing}}/valuations/{{okId}}

### Cleanup
DELETE {{books}}/books/{{bookId}}
