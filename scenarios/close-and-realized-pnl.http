###############################################################################
# Scenario: close a trade -> realized PnL is finalized
# Open a BUY at the live ask, see live unrealized PnL, close it at the live bid;
# pricing then finalizes: unrealized -> 0, realized set, total = realized.
# All queried by trade id (no noise). (Double-close guard: see idempotency.http.)
###############################################################################

@marketData = http://localhost:8001
@books      = http://localhost:8004
@actions    = http://localhost:8008
@pricing    = http://localhost:8002

### Book
# @name createBook
POST {{books}}/books
Content-Type: application/json

{ "name": "CLOSE_DEMO_{{$timestamp}}", "expected_asset_class": "EQUITY" }

###
@bookId = {{createBook.response.body.$.book_id}}

### Live market (BUY fills at ask, close the long at bid)
# @name snap
GET {{marketData}}/snapshot

###
@ask = {{snap.response.body.$.spots.ACME.ask}}
@bid = {{snap.response.body.$.spots.ACME.bid}}

### Open a BUY at the live ask
# @name openTrade
POST {{actions}}/trade-actions
Content-Type: application/json

{ "action_type": "OPEN_TRADE", "client_request_id": "open-{{$timestamp}}", "book_id": "{{bookId}}", "asset_class": "EQUITY", "symbol": "ACME", "side": "BUY", "quantity": 100, "trade_price": {{ask}} }

###
@tradeId = {{openTrade.response.body.$.trade_id}}

### --- wait ~2s --- BEFORE close: unrealized live, realized 0
GET {{pricing}}/valuations/{{tradeId}}


###
@bookId = {{createBook.response.body.$.book_id}}

### Live market (Close the long at bid)
# @name snapClose
GET {{marketData}}/snapshot

###
@ask = {{snapClose.response.body.$.spots.ACME.ask}}
@bid = {{snapClose.response.body.$.spots.ACME.bid}}

### Close the long at the live bid
POST {{actions}}/trade-actions
Content-Type: application/json

{ "action_type": "CLOSE_TRADE", "client_request_id": "close-{{$timestamp}}", "trade_id": "{{tradeId}}", "close_price": {{bid}}, "close_reason": "RANDOM_TRADE_OUT" }

### --- wait ~3s for pricing to finalize --- AFTER close: unrealized=0, realized set, total=realized
GET {{pricing}}/valuations/{{tradeId}}

### Cleanup
DELETE {{books}}/books/{{bookId}}
