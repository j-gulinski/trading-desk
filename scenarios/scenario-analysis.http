###############################################################################
# Scenario analysis — POST /scenario on pricing service
#
# The pricing service still needs its live spot/curve cache. `current_price` is
# optional: when supplied it anchors the base display price while the model
# difference between base and shocked inputs still drives the scenario move.
#
# Shock convention (presentation 9, Scenario analysis dla portfela):
#   EQUITY / COMMODITY / FX / EUROPEAN_OPTION — decimal spot % (0.10 = +10%)
#   BOND / IRS                              — parallel curve bp (25 = +25 bp)
# For IRS, both the discount and projection curves move by the same shock.
#
# BUY scenario_pnl = scenario_value - base_value; SELL reverses that sign.
###############################################################################

@pricing = http://localhost:8002

### EQUITY - +10% spot shock
POST {{pricing}}/scenario
Content-Type: application/json

{
  "position": {
    "side": "BUY",
    "quantity": 100,
    "trade_price": 300.00,
    "instrument": {
      "asset_class": "EQUITY",
      "symbol": "AAPL",
      "current_price": 310.00
    }
  },
  "shock": 0.10,
  "market_data_provider": "FINNHUB"
}

### EQUITY - -10% spot shock (downside)
POST {{pricing}}/scenario
Content-Type: application/json

{
  "position": {
    "side": "BUY",
    "quantity": 100,
    "trade_price": 300.00,
    "instrument": {
      "asset_class": "EQUITY",
      "symbol": "AAPL",
      "current_price": 310.00
    }
  },
  "shock": -0.10,
  "market_data_provider": "FINNHUB"
}

### COMMODITY - +10% spot shock
POST {{pricing}}/scenario
Content-Type: application/json

{
  "position": {
    "side": "BUY",
    "quantity": 10,
    "trade_price": 4500.00,
    "instrument": {
      "asset_class": "COMMODITY",
      "symbol": "XAUUSD",
      "current_price": 4629.00
    }
  },
  "shock": 0.10,
  "market_data_provider": "TWELVE_DATA"
}

### FX - +1% spot shock
POST {{pricing}}/scenario
Content-Type: application/json

{
  "position": {
    "side": "BUY",
    "quantity": 100000,
    "trade_price": 1.0850,
    "instrument": {
      "asset_class": "FX",
      "symbol": "EURUSD",
      "current_price": 1.1000,
      "meta": { "tenor_years": 1.0 }
    }
  },
  "shock": 0.01,
  "market_data_provider": "TWELVE_DATA"
}

### BOND - +25 bps rates shock
POST {{pricing}}/scenario
Content-Type: application/json

{
  "position": {
    "side": "BUY",
    "quantity": 1,
    "trade_price": 1000.00,
    "instrument": {
      "asset_class": "BOND",
      "symbol": "BOND-USD-5Y",
      "meta": {
        "face_value": 1000,
        "coupon_rate": 5.0,
        "payments_per_year": 2,
        "maturity_years": 5,
        "settlement_currency": "USD",
        "discount_curve": "USD_GOVERNMENT_BONDS"
      }
    }
  },
  "shock": 25
}

### BOND - -25 bps rates shock
POST {{pricing}}/scenario
Content-Type: application/json

{
  "position": {
    "side": "BUY",
    "quantity": 1,
    "trade_price": 1000.00,
    "instrument": {
      "asset_class": "BOND",
      "symbol": "BOND-USD-5Y",
      "meta": {
        "face_value": 1000,
        "coupon_rate": 5.0,
        "payments_per_year": 2,
        "maturity_years": 5,
        "settlement_currency": "USD",
        "discount_curve": "USD_GOVERNMENT_BONDS"
      }
    }
  },
  "shock": -25
}

### IRS - +25 bp parallel shock to discount and projection curves
POST {{pricing}}/scenario
Content-Type: application/json

{
  "position": {
    "side": "BUY",
    "quantity": 1,
    "trade_price": 0,
    "instrument": {
      "asset_class": "IRS",
      "symbol": "IRS-PLN-5Y",
      "meta": {
        "direction": "PAY_FIXED_RECEIVE_FLOAT",
        "settlement_currency": "PLN",
        "notional": 1000000,
        "fixed_rate": 4.5,
        "maturity_years": 5,
        "payments_per_year": 4,
        "floating_rate_index_tenor": "3M",
        "discount_curve": "PLN_RISK_FREE",
        "projection_curve": "PLN_REFERENCE_PROJECTION_3M"
      }
    }
  },
  "shock": 25
}

### European call - +10% underlying spot shock; selected curve is unchanged
POST {{pricing}}/scenario
Content-Type: application/json

{
  "position": {
    "side": "BUY",
    "quantity": 1,
    "trade_price": 10,
    "instrument": {
      "asset_class": "EUROPEAN_OPTION",
      "symbol": "OPT-AAPL-CALL-1Y",
      "meta": {
        "underlying_symbol": "AAPL",
        "option_type": "CALL",
        "strike": 310,
        "maturity_years": 1,
        "multiplier": 1,
        "volatility": 0.22,
        "discount_curve": "USD_RISK_FREE"
      }
    }
  },
  "shock": 0.10,
  "market_data_provider": "FINNHUB"
}
