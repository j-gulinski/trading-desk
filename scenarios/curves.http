###############################################################################
# Curves: FRED + ECB + EIOPA curves, provenance, and
# curve-priced trading with an explicit single-curve IRS approximation.
#
# It covers the /curves routes with per-point provenance and raw source
# responses, the curve ops surface, a manual curve refresh, the term schemas
# with their curve catalog, model-priced IRS open/close on currency-consistent
# curves, and the guards that reject a currency or product-role mismatch.
#
# Prerequisites: the full stack is running and FRED_API_KEY is set (ECB and
# EIOPA work keyless). Curve sets load within a minute of boot;
# FRED DGS series lag 1-2 business days.
###############################################################################

@marketData = http://localhost:8001
@pricing    = http://localhost:8002
@actions    = http://localhost:8008
@books      = http://localhost:8004

# ============================ CURVE OPS SURFACE ============================

### FRED is wired for curves (no quotes); ECB and EIOPA list theirs too
GET {{marketData}}/providers

### FRED runtime: key budget, scheduled cadence, last as-of per curve
GET {{marketData}}/providers/FRED/health

# ============================== CURVE ROUTES ===============================

### Every latest curve set: points with tenor, published percent rate,
### source series and source as-of. EIOPA post-LLP rates are publisher-supplied
### but classified extrapolated/non-liquid with a NULL source series.
GET {{marketData}}/market-data/curves

### One provider's sets via the provider route
GET {{marketData}}/market-data/curves/ECB

### Stored source evidence. FRED/ECB retain decoded upstream responses; EIOPA
### retains a compact release/series/rates summary rather than archive bytes.
GET {{marketData}}/market-data/curves/FRED?raw=1

### Curve sets ride the snapshot next to the spot board
GET {{marketData}}/market-data/snapshot

### Run separately: curve_tick events arrive on the same stream as quotes
GET {{marketData}}/market-data/stream

### Manual refetch of one curve within the provider budget
POST {{marketData}}/market-data/curves/refresh?curve=USD_GOVERNMENT_BONDS

### Whole-provider curve refresh
POST {{marketData}}/market-data/curves/refresh?provider=ECB

### The monthly risk-free curves: three country builds share one cached archive download.
### Each carries the derivation EIOPA itself states — swaps for the euro,
### overnight index swaps for the dollar, government bonds for the zloty —
### and marks points beyond the last liquid point as extrapolated.
POST {{marketData}}/market-data/curves/refresh?provider=EIOPA

# ===================== TERM SCHEMAS AND THE CURVE CATALOG ==================

### IRS/BOND/EUROPEAN_OPTION schemas carry approved curve choices. IRS exposes
### one combined discount/projection field and records the single-curve approach.
GET {{actions}}/instruments/term-schemas

# ========================= MODEL-PRICED EXECUTION ==========================

### An IRS book for the flow
# @name irsBook
POST {{books}}/books
Content-Type: application/json

{ "name": "CURVE_DESK_{{$timestamp}}", "expected_asset_class": "IRS" }

###
@irsBookId = {{irsBook.response.body.$.book_id}}

### Preview the model value the ticket shows (this is the client_seen_price)
# @name irsPreview
POST {{pricing}}/price
Content-Type: application/json

{ "asset_class": "IRS", "symbol": "IRS-PLN-5Y", "terms": { "direction": "PAY_FIXED_RECEIVE_FLOAT", "settlement_currency": "PLN", "notional": 1000000, "fixed_rate": 4.5, "maturity_years": 5, "payments_per_year": 4, "floating_rate_index_tenor": "3M", "discount_curve": "PLN_RISK_FREE" } }

###
@irsSeen = {{irsPreview.response.body.$.price}}

### Open the PLN swap: server uses PLN_RISK_FREE for both roles and freezes
### the shared curve name/as-of plus SINGLE_CURVE_APPROXIMATION in the terms.
# @name irsTrade
POST {{actions}}/trade-actions
Content-Type: application/json

{ "client_request_id": "irs-open-{{$timestamp}}", "book_id": "{{irsBookId}}", "asset_class": "IRS", "symbol": "IRS-PLN-5Y", "side": "BUY", "quantity": 1, "client_seen_price": "{{irsSeen}}", "currency": "PLN", "source": "TRADING_TICKET", "terms": { "direction": "PAY_FIXED_RECEIVE_FLOAT", "settlement_currency": "PLN", "notional": 1000000, "fixed_rate": 4.5, "maturity_years": 5, "payments_per_year": 4, "floating_rate_index_tenor": "3M", "discount_curve": "PLN_RISK_FREE" } }

# ============================ THE CURVE GUARDS =============================

### A PLN swap cannot discount on the USD government-bond curve — rejected (422)
POST {{actions}}/trade-actions
Content-Type: application/json

{ "client_request_id": "irs-guard-ccy-{{$timestamp}}", "book_id": "{{irsBookId}}", "asset_class": "IRS", "symbol": "IRS-PLN-BAD", "side": "BUY", "quantity": 1, "client_seen_price": "0", "terms": { "direction": "PAY_FIXED_RECEIVE_FLOAT", "settlement_currency": "PLN", "notional": 1000000, "fixed_rate": 4.5, "maturity_years": 5, "payments_per_year": 4, "floating_rate_index_tenor": "3M", "discount_curve": "USD_RISK_FREE" } }

### Same currency is insufficient: a USD government curve cannot project an IRS (422)
POST {{actions}}/trade-actions
Content-Type: application/json

{ "client_request_id": "irs-guard-role-{{$timestamp}}", "book_id": "{{irsBookId}}", "asset_class": "IRS", "symbol": "IRS-USD-BAD", "side": "BUY", "quantity": 1, "client_seen_price": "0", "currency": "USD", "terms": { "direction": "PAY_FIXED_RECEIVE_FLOAT", "settlement_currency": "USD", "notional": 1000000, "fixed_rate": 4.5, "maturity_years": 5, "payments_per_year": 4, "floating_rate_index_tenor": "3M", "discount_curve": "USD_GOVERNMENT_BONDS" } }

### The public contract rejects a separately selected projection curve (422)
POST {{actions}}/trade-actions
Content-Type: application/json

{ "client_request_id": "irs-guard-two-curve-{{$timestamp}}", "book_id": "{{irsBookId}}", "asset_class": "IRS", "symbol": "IRS-PLN-BAD", "side": "BUY", "quantity": 1, "client_seen_price": "0", "currency": "PLN", "terms": { "direction": "PAY_FIXED_RECEIVE_FLOAT", "settlement_currency": "PLN", "notional": 1000000, "fixed_rate": 4.5, "maturity_years": 5, "payments_per_year": 4, "floating_rate_index_tenor": "3M", "discount_curve": "PLN_RISK_FREE", "projection_curve": "USD_RISK_FREE" } }

# ===================== THE TRADE AND ITS FROZEN CURVES =====================

### The trade carries MODEL_PV provenance: executed PV, frozen curve names
### with their as-ofs in terms, no quote provider
GET http://localhost:8006/trades?asset_class=IRS&limit=5

### Valuations follow the same curves live (curve_tick revalues the swap)
GET {{pricing}}/valuations

# ================================ CLEANUP ==================================

### Close only the IRS created by this scenario
POST {{actions}}/trade-actions
Content-Type: application/json

{ "action_type": "CLOSE_TRADE", "client_request_id": "irs-close-{{$timestamp}}", "trade_id": "{{irsTrade.response.body.$.trade_id}}", "client_seen_price": "{{irsSeen}}", "close_reason": "CURVE_SCENARIO_CLEANUP" }

### Wait a few seconds for the asynchronous close, then deactivate the empty book
DELETE {{books}}/books/{{irsBookId}}
